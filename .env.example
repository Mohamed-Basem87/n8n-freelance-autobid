# Copy these into your n8n environment, not into this file.

# Shared secret between n8n and the host service (API_KEY from host-api.env).
LOKI_API_KEY=

# Where n8n reaches the backend. From a Docker container, the host is usually
# host.docker.internal; on the same machine, http://127.0.0.1:8000.
LOKI_BACKEND_URL=http://host.docker.internal:8000

# Telegram chat id that receives one alert per attempt.
TELEGRAM_CHAT_ID=

# n8n blocks $env inside expressions unless this is false. The workflow uses
# $env for the three values above.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
