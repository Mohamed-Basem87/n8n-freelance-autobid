# Backend service configuration.
# Copy to host-api.env and keep it out of version control.

# Shared secret. The n8n workflow must send it as:  Authorization: Bearer <API_KEY>
# Generate one with:  openssl rand -hex 32
API_KEY=replace-me-with-a-long-random-string

# Hard safety gate. While this is 0 the service fills and validates the offer
# form but never clicks submit. Set to 1 only when you are ready for real bids.
ALLOW_SUBMIT=0

# Require exactly four portfolio images on every proposal.
# Kafiil's bid form has no upload field, so it always skips attachments.
ATTACHMENTS_REQUIRED=1

# Telegram delivery for the filled-proposal screenshot.
# The backend sends the photo itself via /notify-screenshot, then deletes it.
# Leave empty to disable photo delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the Firefox profile, screenshots and portfolio images live.
LOKI_DATA_DIR=/opt/freelance-autobid/data

# Optional overrides (defaults shown).
# LOKI_PROFILE_DIR=/opt/freelance-autobid/data/test-profile
# LOKI_SCREENSHOT_DIR=/opt/freelance-autobid/data/screenshots
# LOKI_ATTACHMENTS_DIR=/opt/freelance-autobid/data/attachments
# LOKI_FIREFOX_BINARY=/usr/bin/firefox-esr
